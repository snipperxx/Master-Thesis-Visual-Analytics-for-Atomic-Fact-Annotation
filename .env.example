# Copy to .env and fill in. .env is gitignored (never commit secrets).

# Neo4j password (>= 8 chars). Consumed by docker-compose.
NEO4J_PASSWORD=test12345

# Group-hosted Ollama (OpenWebUI proxy; the Ollama API sits under /ollama).
# Leave OLLAMA_CLOUD_API_KEY blank to disable cloud models (the UI then shows
# local models only). API key: OpenWebUI -> Settings -> Account.
OLLAMA_CLOUD_URL=https://<openwebui-host>/ollama
OLLAMA_CLOUD_API_KEY=

# Optional: override the local Ollama endpoint (default http://localhost:11434)
# OLLAMA_URL=http://localhost:11434
